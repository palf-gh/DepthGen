# CMake and IDE output
/build/
/out/
/.vs/
/.idea/
compile_commands.json

# Downloaded, reproducible runtime assets. These never belong in Git.
/third_party/runtime/
/Resources/Models/*.onnx
/Resources/Models/*.data
/Resources/Models/*.sha256

# Keep Release plug-in deliverables versioned (BitonicPixelSorterForAE layout),
# but ignore non-release outputs. Model weights and ONNX Runtime binaries remain
# gitignored even when they sit inside a Release tree.
/dist/Win/Debug/
/dist/Win/RelWithDebInfo/
/dist/Win/MinSizeRel/
/dist/Mac/Debug/
/dist/Mac/RelWithDebInfo/
/dist/Mac/MinSizeRel/
/dist/**/*.onnx
/dist/**/*.dll
/dist/**/*.dylib
/package/

# macOS Finder and Windows Explorer metadata
.DS_Store
Thumbs.db
