# CMake and IDE output
/build/
/out/
/.vs/
/.idea/
compile_commands.json

# Downloaded, reproducible runtime assets. These never belong in Git.
/third_party/runtime/
/Resources/Models/*.onnx
/Resources/Models/*.data
/Resources/Models/*.sha256

# Local CMake outputs. Embedded models make Release plug-ins exceed GitHub's
# 100 MB blob limit, so binaries are not tracked; ship them via GitHub Releases.
/dist/
/package/

# macOS Finder and Windows Explorer metadata
.DS_Store
Thumbs.db
